{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
      },
      "uniqueItems": true
    },
    "data": {
      "type": "object",
      "minProperties": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "classification": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
                },
                "pointer": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "source_id",
                "pointer",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "classification",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "complete",
        "limitations"
      ],
      "additionalProperties": false
    },
    "qa": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "passed",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "work_mode": {
      "enum": [
        "analysis",
        "planning",
        "draft"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "node_id",
    "role",
    "input_artifact_ids",
    "source_ids",
    "data",
    "claims",
    "coverage",
    "qa",
    "work_mode"
  ],
  "additionalProperties": false
}
