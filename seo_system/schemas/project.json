{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spinoff.local/schemas/project.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "site_revision": {
      "type": "string",
      "minLength": 1
    },
    "business_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "country",
        "region",
        "language",
        "engines",
        "devices"
      ],
      "additionalProperties": false
    },
    "drive_root_folder_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "monthly_capacity_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "profile_version",
    "domains",
    "allowed_hosts",
    "site_revision",
    "business_goals",
    "timezone",
    "market",
    "drive_root_folder_id",
    "monthly_capacity_hours"
  ],
  "additionalProperties": false
}
