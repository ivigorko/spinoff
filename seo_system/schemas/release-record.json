{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_revision": {
      "type": "string",
      "minLength": 1
    },
    "target_revision": {
      "type": "string",
      "minLength": 1
    },
    "urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "expected": {}
        },
        "required": [
          "task_id",
          "url",
          "field",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "change_kind": {
      "enum": [
        "content",
        "technical"
      ]
    },
    "executor": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "release_id",
    "released_at",
    "baseline_revision",
    "target_revision",
    "urls",
    "authorization_ref",
    "task_ids",
    "expected_changes"
  ],
  "additionalProperties": false
}
