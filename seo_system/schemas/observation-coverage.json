{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "start": {
      "type": "string",
      "format": "date"
    },
    "end": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "property_ref": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "definition_version": {
          "type": "string",
          "minLength": 1
        },
        "filters_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host",
        "region",
        "engine",
        "device",
        "property_ref",
        "timezone",
        "definition_version",
        "filters_hash"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "aggregation": {
      "const": "sum"
    },
    "coverage_status": {
      "enum": [
        "confirmed_complete",
        "incomplete",
        "unknown"
      ]
    },
    "observation_start": {
      "type": "string",
      "format": "date-time"
    },
    "observation_end": {
      "type": "string",
      "format": "date-time"
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start",
          "end",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "coverage_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Source-backed tracking lifecycle and continuity evidence; not inferred from zero-filled daily rows."
    },
    "daily_values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "start",
    "end",
    "scope",
    "metric",
    "unit",
    "aggregation",
    "coverage_status",
    "observation_start",
    "observation_end",
    "known_gaps",
    "coverage_basis",
    "daily_values"
  ]
}
