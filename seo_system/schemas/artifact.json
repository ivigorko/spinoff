{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spinoff.local/schemas/artifact.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_path": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "local_validated"
    },
    "storage": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "local"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "parent_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "project_id",
    "run_id",
    "logical_path",
    "kind",
    "sha256",
    "created_at",
    "status",
    "storage",
    "parent_artifact_ids"
  ],
  "additionalProperties": false
}
