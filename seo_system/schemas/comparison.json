{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseline": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "property_ref": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "definition_version": {
              "type": "string",
              "minLength": 1
            },
            "filters_hash": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "host",
            "region",
            "engine",
            "device",
            "property_ref",
            "timezone",
            "definition_version",
            "filters_hash"
          ],
          "additionalProperties": false
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_id",
            "pointer"
          ],
          "additionalProperties": false
        },
        "coverage_evidence": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_id",
            "pointer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "start",
        "end",
        "scope",
        "metric",
        "unit",
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "property_ref": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "definition_version": {
              "type": "string",
              "minLength": 1
            },
            "filters_hash": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "host",
            "region",
            "engine",
            "device",
            "property_ref",
            "timezone",
            "definition_version",
            "filters_hash"
          ],
          "additionalProperties": false
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_id",
            "pointer"
          ],
          "additionalProperties": false
        },
        "coverage_evidence": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_id",
            "pointer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "start",
        "end",
        "scope",
        "metric",
        "unit",
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "absolute_change": {
      "type": [
        "number",
        "null"
      ]
    },
    "percent_change": {
      "type": [
        "number",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "equal_duration",
        "calendar_month"
      ],
      "default": "equal_duration",
      "description": "Explicit opt-in; calendar_month requires complete observation evidence for two whole calendar months."
    }
  },
  "required": [
    "baseline",
    "current",
    "absolute_change",
    "percent_change"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "calendar_month"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "baseline": {
            "required": [
              "coverage_evidence"
            ]
          },
          "current": {
            "required": [
              "coverage_evidence"
            ]
          }
        }
      }
    }
  ]
}
