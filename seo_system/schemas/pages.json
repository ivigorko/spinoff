{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spinoff.local/schemas/pages.json",
  "type": "array",
  "minItems": 1,
  "maxItems": 100000,
  "items": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "status_code": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      },
      "title": {
        "type": "string"
      },
      "h1": {
        "type": "string"
      }
    },
    "required": [
      "url",
      "status_code"
    ],
    "additionalProperties": false
  }
}
